#!/bin/ash
# 静态住宅 SOCKS5 出口接口：新增、编辑、删除多个住宅出口。

BASE=${SHELLCRASH_HOME:-/data/other_vol/ShellCrash}
APP_DIR=$(cd "$(dirname "$0")/../.." && pwd)
RESIDENTIAL_NODES_FILE="$APP_DIR/residential-nodes.db"
RES_HELPERS="$APP_DIR/scripts/residential_nodes.sh"
SETUP_SCRIPT="$APP_DIR/scripts/setup-shellcrash-custom.sh"
LOG_FILE="$APP_DIR/last-residential.log"
PARAMS="$QUERY_STRING"
[ -f "$RES_HELPERS" ] && . "$RES_HELPERS"

[ "$REQUEST_METHOD" = "POST" ] && [ "${CONTENT_LENGTH:-0}" -gt 0 ] && {
    PARAMS="$PARAMS&$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)"
}

send_json() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
    printf '%s\n' "$1"
    exit 0
}

json_escape() {
    printf '%s' "$1" | awk '{
        gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); gsub(/\r/,"")
        if (NR > 1) printf "\\n"
        printf "%s", $0
    }'
}

urldecode() {
    local value
    value=$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')
    printf '%b' "$value"
}

param() {
    local key="$1" raw
    raw=$(printf '%s' "$PARAMS" | tr '&' '\n' | sed -n "s/^$key=//p" | tail -n 1)
    urldecode "$raw"
}

one_line() {
    printf '%s' "$1" | tr -d '\r\n'
}

ok() {
    local message
    message=$(json_escape "$1")
    send_json "{\"ok\":true,\"message\":\"$message\"}"
}

fail() {
    local message
    message=$(json_escape "$1")
    send_json "{\"ok\":false,\"message\":\"$message\"}"
}

mask_value() {
    local value="$1" len=${#value}
    [ -n "$value" ] || { echo ""; return; }
    [ "$len" -le 6 ] && { echo "***"; return; }
    printf '%s***%s' "$(printf '%s' "$value" | cut -c 1-2)" "$(printf '%s' "$value" | sed 's/.*\(..\)$/\1/')"
}

list_nodes() {
    local first=1 password_mask
    ensure_residential_nodes "$BASE/yamls/proxies.yaml"
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
    printf '{"ok":true,"nodes":['
    [ -f "$RESIDENTIAL_NODES_FILE" ] && while IFS='|' read -r id enabled name server port username password; do
        [ -n "$id" ] || continue
        password_mask=$(json_escape "$(mask_value "$password")")
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"id":"%s","enabled":"%s","name":"%s","server":"%s","port":"%s","username":"%s","passwordMasked":"%s"}' \
            "$(json_escape "$id")" "$(json_escape "$enabled")" "$(json_escape "$name")" \
            "$(json_escape "$server")" "$(json_escape "$port")" \
            "$(json_escape "$username")" "$password_mask"
    done < "$RESIDENTIAL_NODES_FILE"
    printf ']}\n'
    exit 0
}

save_node() {
    local id enabled name server port username password old old_password tmp
    id=$(one_line "$(param id)")
    enabled=$(one_line "$(param enabled)")
    name=$(one_line "$(param name)")
    server=$(one_line "$(param server)")
    port=$(one_line "$(param port)")
    username=$(one_line "$(param username)")
    password=$(one_line "$(param password)")

    [ -n "$id" ] || id="$(date +%s)"
    [ "$enabled" = "OFF" ] || enabled=ON
    [ -n "$name" ] || fail "出口名称不能为空。"
    [ -n "$server" ] || fail "服务器地址不能为空。"
    res_valid_port "$port" || fail "端口必须是 1-65535。"
    [ -f "$RESIDENTIAL_NODES_FILE" ] && awk -F'|' -v id="$id" -v name="$name" '$1 != id && $3 == name {found=1} END {exit found ? 0 : 1}' "$RESIDENTIAL_NODES_FILE" && fail "出口名称不能重复，请换一个名称。"

    old=$(res_find_node_line "$id")
    old_password=$(printf '%s' "$old" | awk -F'|' '{print $7}')
    [ -n "$password" ] || password="$old_password"
    [ -n "$password" ] || fail "静态住宅 SOCKS5 出口必须填写密码。"

    mkdir -p "$APP_DIR"
    tmp="$RESIDENTIAL_NODES_FILE.tmp.$$"
    [ -f "$RESIDENTIAL_NODES_FILE" ] && awk -F'|' -v id="$id" '$1 != id' "$RESIDENTIAL_NODES_FILE" > "$tmp" || : > "$tmp"
    res_node_line "$id" "$enabled" "$name" "$server" "$port" "$username" "$password" >> "$tmp"
    mv "$tmp" "$RESIDENTIAL_NODES_FILE"
    chmod 600 "$RESIDENTIAL_NODES_FILE" 2>/dev/null
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1
    ok "静态住宅出口已保存。点击顶部“更新配置”后生效。"
}

delete_node() {
    local id tmp
    id=$(one_line "$(param id)")
    [ -n "$id" ] || fail "请选择要删除的出口。"
    tmp="$RESIDENTIAL_NODES_FILE.tmp.$$"
    [ -f "$RESIDENTIAL_NODES_FILE" ] && awk -F'|' -v id="$id" '$1 != id' "$RESIDENTIAL_NODES_FILE" > "$tmp" || : > "$tmp"
    mv "$tmp" "$RESIDENTIAL_NODES_FILE"
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1
    ok "静态住宅出口已删除。点击顶部“更新配置”后生效。"
}

apply_nodes() {
    [ -x "$SETUP_SCRIPT" ] || fail "没有找到配置生成脚本。"
    SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1
    ok "静态住宅出口配置已重新生成。点击顶部“更新配置”后生效。"
}

action=$(one_line "$(param action)")
[ -n "$action" ] || action=list
case "$action" in
    list) list_nodes ;;
    save) save_node ;;
    delete) delete_node ;;
    apply) apply_nodes ;;
    *) fail "未知操作。" ;;
esac
