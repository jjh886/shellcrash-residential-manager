#!/bin/ash
# 自建节点接口：新增、编辑、删除多台服务器节点。

BASE=${SHELLCRASH_HOME:-/data/other_vol/ShellCrash}
APP_DIR=$(cd "$(dirname "$0")/../.." && pwd)
CUSTOM_NODES_FILE="$APP_DIR/custom-nodes.db"
NODE_HELPERS="$APP_DIR/scripts/custom_nodes.sh"
SETUP_SCRIPT="$APP_DIR/scripts/setup-shellcrash-custom.sh"
LOG_FILE="$APP_DIR/last-nodes.log"
CGI_COMMON="$APP_DIR/scripts/cgi_common.sh"
[ -f "$NODE_HELPERS" ] && . "$NODE_HELPERS"
[ -f "$CGI_COMMON" ] && . "$CGI_COMMON" || {
    printf 'Content-Type: application/json\r\n\r\n{"ok":false,"message":"缺少 CGI 公共工具脚本。"}\n'
    exit 0
}
cgi_read_params

list_nodes() {
    local first=1
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
    printf '{"ok":true,"nodes":['
    [ -f "$CUSTOM_NODES_FILE" ] && while IFS='|' read -r id enabled name proto server port username password cipher uuid sni flow public_key short_id use_residential; do
        [ -n "$id" ] || continue
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"id":"%s","enabled":"%s","name":"%s","type":"%s","server":"%s","port":"%s","username":"%s","cipher":"%s","uuid":"%s","sni":"%s","flow":"%s","publicKey":"%s","shortId":"%s","useResidential":"%s"}' \
            "$(json_escape "$id")" "$(json_escape "$enabled")" "$(json_escape "$name")" \
            "$(json_escape "$proto")" "$(json_escape "$server")" "$(json_escape "$port")" \
            "$(json_escape "$username")" "$(json_escape "$cipher")" \
            "$(json_escape "$uuid")" "$(json_escape "$sni")" "$(json_escape "$flow")" \
            "$(json_escape "$public_key")" "$(json_escape "$short_id")" "$(json_escape "$use_residential")"
    done < "$CUSTOM_NODES_FILE"
    printf ']}\n'
    exit 0
}

save_node() {
    local id enabled name proto server port username password cipher uuid sni flow public_key short_id use_residential
    local old old_password tmp
    id=$(one_line "$(param id)")
    enabled=$(one_line "$(param enabled)")
    name=$(one_line "$(param name)")
    proto=$(one_line "$(param type)")
    server=$(one_line "$(param server)")
    port=$(one_line "$(param port)")
    username=$(one_line "$(param username)")
    password=$(one_line "$(param password)")
    cipher=$(one_line "$(param cipher)")
    uuid=$(one_line "$(param uuid)")
    sni=$(one_line "$(param sni)")
    flow=$(one_line "$(param flow)")
    public_key=$(one_line "$(param public_key)")
    short_id=$(one_line "$(param short_id)")
    use_residential=$(one_line "$(param use_residential)")

    [ -n "$id" ] || id="$(date +%s)"
    [ "$enabled" = "OFF" ] || enabled=ON
    [ "$use_residential" = "ON" ] || use_residential=OFF
    case "$proto" in shadowsocks|ss|socks5|http|vless|vless-ws-tls) ;; *) fail "协议只能选择 Shadowsocks、Socks5、HTTP、VLESS Reality 或 VLESS WS TLS。" ;; esac
    [ -n "$name" ] || fail "节点名称不能为空。"
    [ -n "$server" ] || fail "服务器地址不能为空。"
    valid_port_value "$port" || fail "端口必须是 1-65535。"
    [ -f "$CUSTOM_NODES_FILE" ] && awk -F'|' -v id="$id" -v name="$name" '$1 != id && $3 == name {found=1} END {exit found ? 0 : 1}' "$CUSTOM_NODES_FILE" && fail "节点名称不能重复，请换一个名称。"

    old=$(find_node_line "$id")
    old_password=$(printf '%s' "$old" | awk -F'|' '{print $8}')
    [ -n "$password" ] || password="$old_password"
    if [ "$proto" = "ss" ] || [ "$proto" = "shadowsocks" ]; then
        [ -n "$cipher" ] || cipher=aes-128-gcm
        [ -n "$password" ] || fail "Shadowsocks 节点必须填写密码。"
    fi
    case "$proto" in
        vless|vless-ws-tls) [ -n "$uuid" ] || fail "VLESS 节点必须填写 UUID。" ;;
    esac

    mkdir -p "$APP_DIR"
    tmp="$CUSTOM_NODES_FILE.tmp.$$"
    [ -f "$CUSTOM_NODES_FILE" ] && awk -F'|' -v id="$id" '$1 != id' "$CUSTOM_NODES_FILE" > "$tmp" || : > "$tmp"
    node_line "$id" "$enabled" "$name" "$proto" "$server" "$port" "$username" "$password" \
        "$cipher" "$uuid" "$sni" "$flow" "$public_key" "$short_id" "$use_residential" >> "$tmp"
    mv "$tmp" "$CUSTOM_NODES_FILE"
    chmod 600 "$CUSTOM_NODES_FILE" 2>/dev/null
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1
    ok "自建节点已保存。点击顶部“更新配置”后生效。"
}

delete_node() {
    local id tmp
    id=$(one_line "$(param id)")
    [ -n "$id" ] || fail "请选择要删除的节点。"
    tmp="$CUSTOM_NODES_FILE.tmp.$$"
    [ -f "$CUSTOM_NODES_FILE" ] && awk -F'|' -v id="$id" '$1 != id' "$CUSTOM_NODES_FILE" > "$tmp" || : > "$tmp"
    mv "$tmp" "$CUSTOM_NODES_FILE"
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >"$LOG_FILE" 2>&1
    ok "自建节点已删除。点击顶部“更新配置”后生效。"
}

action=$(one_line "$(param action)")
[ -n "$action" ] || action=list
case "$action" in
    list) list_nodes ;;
    save) save_node ;;
    delete) delete_node ;;
    *) fail "未知操作。" ;;
esac
