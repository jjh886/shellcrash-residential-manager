#!/bin/ash
# 这是页面调用的后端接口，负责 ShellCrash 安装、服务管理和持久化配置。
# 订阅更新会覆盖 yamls/config.yaml，但不会覆盖这里维护的 proxies/rules 文件。
BASE=${SHELLCRASH_HOME:-/data/other_vol/ShellCrash}
APP_DIR=$(cd "$(dirname "$0")/../.." && pwd)
YAML_DIR="$BASE/yamls"
CFG_FILE="$BASE/configs/ShellCrash.cfg"
RULES_FILE="$YAML_DIR/rules.yaml"
LEAK_GUARD="$BASE/task/block_proxy_leaks.sh"
SETUP_SCRIPT="$APP_DIR/scripts/setup-shellcrash-custom.sh"
INSTALL_SCRIPT="$APP_DIR/scripts/shellcrash-auto-install.sh"
PUBLISH_SCRIPT="$APP_DIR/scripts/client_subscription_publish.sh"
CLIENT_SUB_LOG="$APP_DIR/last-client-subscription.log"
RUNTIME_CONFIG="/tmp/ShellCrash/config.yaml"
RULE_HELPERS="$APP_DIR/scripts/rule_helpers.sh"
CGI_COMMON="$APP_DIR/scripts/cgi_common.sh"
BACKUP_DIR="$APP_DIR/backups"
RES_GROUP="静态住宅IP"
JP_RULE_GROUP="日本专用节点"
DEFAULT_ROUTER_IP=${MANAGER_ROUTER_IP:-192.168.0.1}
[ -f "$RULE_HELPERS" ] && . "$RULE_HELPERS"
[ -f "$CGI_COMMON" ] && . "$CGI_COMMON" || {
    printf 'Content-Type: application/json\r\n\r\n{"ok":false,"message":"缺少 CGI 公共工具脚本。"}\n'
    exit 0
}
cgi_read_params
cfg_has_subscription() {
    [ -f "$CFG_FILE" ] || return 1
    grep -Eq "^(Https|Url)='?https?://" "$CFG_FILE"
}
get_cfg_value() {
    local key="$1"
    [ -f "$CFG_FILE" ] || return 0
    sed -n "s/^$key='\(.*\)'$/\1/p; s/^$key=\(.*\)$/\1/p" "$CFG_FILE" | head -n 1
}
require_shellcrash() {
    [ -x "$BASE/start.sh" ] && [ -x "$BASE/task/task.sh" ] && return 0
    fail "还没有找到 ShellCrash，请先点击“安装 ShellCrash”。"
}
set_cfg_plain() {
    local key="$1"
    local value="$2"
    local tmp="$CFG_FILE.tmp.$$"
    local found=0
    mkdir -p "$(dirname "$CFG_FILE")"
    touch "$CFG_FILE"
    while IFS= read -r line; do
        case "$line" in
            "$key="*)
                echo "$key=$value"
                found=1
                ;;
            *)
                echo "$line"
                ;;
        esac
    done < "$CFG_FILE" > "$tmp"
    [ "$found" -eq 0 ] && echo "$key=$value" >> "$tmp"
    mv "$tmp" "$CFG_FILE"
}
set_cfg_quoted() {
    local key="$1"
    local value
    local tmp="$CFG_FILE.tmp.$$"
    local found=0
    value=$(shell_quote "$2")
    mkdir -p "$(dirname "$CFG_FILE")"
    touch "$CFG_FILE"
    while IFS= read -r line; do
        case "$line" in
            "$key="*)
                echo "$key='$value'"
                found=1
                ;;
            *)
                echo "$line"
                ;;
        esac
    done < "$CFG_FILE" > "$tmp"
    [ "$found" -eq 0 ] && echo "$key='$value'" >> "$tmp"
    mv "$tmp" "$CFG_FILE"
}
ensure_shellcrash_flags() {
    # 这些开关用于减少绕过和误代理：常用端口关闭、嗅探开启、国内 IP 直连。
    set_cfg_plain common_ports OFF
    set_cfg_plain sniffer ON
    set_cfg_plain ipv6_dns OFF
    set_cfg_plain cn_ip_route ON
}
publish_client_subscription() {
    # 公网客户端订阅是给电脑、手机和其他路由器用的，更新后同步跑一遍，避免远端还停在旧规则。
    [ -x "$PUBLISH_SCRIPT" ] || {
        echo "客户端订阅发布脚本不存在，已跳过公网同步。" > "$CLIENT_SUB_LOG"
        return 0
    }
    "$PUBLISH_SCRIPT" "$RUNTIME_CONFIG" > "$CLIENT_SUB_LOG" 2>&1
}
write_rules_file() {
    local direct_domains="$1"
    local proxy_domains="$2"
    local direct_keywords="$3"
    local proxy_keywords="$4"
    local jp_domains="$5"
    mkdir -p "$YAML_DIR"
    backup_file "$RULES_FILE"
    {
        echo "# 少量手动分流补丁：默认留空，不接管订阅规则。"
        echo "# shellcrash-manager:direct-domains-begin"
        emit_domain_rules "$direct_domains" DIRECT
        echo "# shellcrash-manager:direct-domains-end"
        echo "# shellcrash-manager:direct-keywords-begin"
        emit_keyword_rules "$direct_keywords" DIRECT
        echo "# shellcrash-manager:direct-keywords-end"
        echo "# shellcrash-manager:jp-domains-begin"
        emit_domain_rules "$jp_domains" "$JP_RULE_GROUP"
        echo "# shellcrash-manager:jp-domains-end"
        echo "# shellcrash-manager:jp-keywords-begin"
        emit_keyword_rules "bycsi
bybit
bytick" "$JP_RULE_GROUP"
        echo "# shellcrash-manager:jp-keywords-end"
        echo "# shellcrash-manager:proxy-domains-begin"
        emit_domain_rules "$proxy_domains" "$RES_GROUP"
        echo "# shellcrash-manager:proxy-domains-end"
        echo "# shellcrash-manager:proxy-keywords-begin"
        emit_keyword_rules "$proxy_keywords" "$RES_GROUP"
        echo "# shellcrash-manager:proxy-keywords-end"
    } > "$RULES_FILE"
    chmod 600 "$RULES_FILE" 2>/dev/null
}
guard_active() {
    iptables -S FORWARD 2>/dev/null | grep -q shellcrash-leak-guard
}
shellcrash_running() {
    ps 2>/dev/null | grep -q '[C]rashCore'
}
manager_running() {
    ps w 2>/dev/null | grep -q '[u]httpd .*shellcrash-manager/www'
}

router_host() {
    local host
    # CGI 会带上浏览器访问管理页时的 Host，优先复用它，避免 LAN 地址改动后还残留旧地址。
    host=$(printf '%s' "${HTTP_HOST:-}" | cut -d: -f1)
    [ -n "$host" ] || host="$DEFAULT_ROUTER_IP"
    printf '%s\n' "$host"
}

panel_info() {
    local raw parsed
    ROUTER_HOST=$(router_host)
    PANEL_PORT=$(get_cfg_value db_port)
    PANEL_PATH=/ui
    [ -n "$PANEL_PORT" ] || PANEL_PORT=9999
    raw=$(get_cfg_value hostdir | tr -d "'")
    parsed=$(printf '%s' "$raw" | sed -n 's/.*: *\([0-9][0-9]*\)\(\/[^ ]*\).*/\1|\2/p' | head -n 1)
    if [ -n "$parsed" ]; then
        PANEL_PORT=$(printf '%s' "$parsed" | cut -d'|' -f1)
        PANEL_PATH=$(printf '%s' "$parsed" | cut -d'|' -f2)
    elif echo "$raw" | grep -q '^/'; then
        PANEL_PATH="$raw"
    fi
    PANEL_URL="http://${ROUTER_HOST}:${PANEL_PORT}${PANEL_PATH}/"
}
status_json() {
    local version panel_raw_j panel_url_j panel_path_j direct_j proxy_j direct_kw_j proxy_kw_j jp_j res_count proxy_domains proxy_keywords ui_url_j
    version=$(get_cfg_value versionsh_l)
    panel_info
    panel_raw_j=$(json_escape "$(get_cfg_value hostdir)")
    panel_url_j=$(json_escape "$PANEL_URL")
    panel_path_j=$(json_escape "$PANEL_PATH")
    ui_url_j=$(json_escape "http://${ROUTER_HOST}:19999/")
    direct_j=$(json_escape "$(extract_domains direct-domains DIRECT)")
    proxy_domains=$(extract_domains proxy-domains "$RES_GROUP")
    [ -n "$proxy_domains" ] || proxy_domains=$(extract_domains proxy-domains "美国静态住宅IP")
    proxy_j=$(json_escape "$proxy_domains")
    direct_kw_j=$(json_escape "$(extract_keywords direct-keywords DIRECT)")
    proxy_keywords=$(extract_keywords proxy-keywords "$RES_GROUP")
    [ -n "$proxy_keywords" ] || proxy_keywords=$(extract_keywords proxy-keywords "美国静态住宅IP")
    proxy_kw_j=$(json_escape "$proxy_keywords")
    jp_j=$(json_escape "$(extract_domains jp-domains "$JP_RULE_GROUP")")
    shellcrash_running && running=true || running=false
    manager_running && manager=true || manager=false
    guard_active && guard=true || guard=false
    cfg_has_subscription && sub=true || sub=false
    res_count=$(awk -F'|' '$2 == "ON" {n++} END {print n+0}' "$APP_DIR/residential-nodes.db" 2>/dev/null)
    [ -x "$BASE/start.sh" ] && installed=true || installed=false
    send_json "{\"ok\":true,\"installed\":$installed,\"shellcrashRunning\":$running,\"managerRunning\":$manager,\"guardActive\":$guard,\"subscriptionConfigured\":$sub,\"version\":\"$version\",\"crashDir\":\"$BASE\",\"panel\":\"$panel_raw_j\",\"panelUrl\":\"$panel_url_j\",\"panelPort\":\"$PANEL_PORT\",\"panelPath\":\"$panel_path_j\",\"rules\":{\"directDomains\":\"$direct_j\",\"proxyDomains\":\"$proxy_j\",\"directKeywords\":\"$direct_kw_j\",\"proxyKeywords\":\"$proxy_kw_j\",\"jpDomains\":\"$jp_j\"},\"residential\":{\"count\":$res_count},\"uiUrl\":\"$ui_url_j\"}"
}
save_config() {
    local scope subscription direct_domains proxy_domains direct_keywords proxy_keywords jp_domains
    scope=$(one_line "$(param scope)")
    [ -n "$scope" ] || scope=all
    case "$scope" in all|subscription|rules) ;; *) fail "未知保存范围。" ;; esac
    subscription=$(one_line "$(param subscription_url)")
    require_shellcrash
    backup_file "$CFG_FILE"

    if [ "$scope" = "subscription" ]; then
        [ -n "$subscription" ] || ok "订阅链接未填写，已保留当前订阅。"
        set_cfg_quoted Https "$subscription"
        set_cfg_quoted Url "$subscription"
        ok "订阅链接已保存，点击“保存并更新订阅”可立即拉取新节点。"
    fi

    if has_param direct_domains; then
        direct_domains=$(normalize_domains "$(param direct_domains)")
    else
        direct_domains=$(extract_domains direct-domains DIRECT)
    fi
    if has_param direct_keywords; then
        direct_keywords=$(normalize_keywords "$(param direct_keywords)")
    else
        direct_keywords=$(extract_keywords direct-keywords DIRECT)
    fi
    if has_param proxy_domains; then
        proxy_domains=$(normalize_domains "$(param proxy_domains)")
    else
        proxy_domains=$(extract_domains proxy-domains "$RES_GROUP")
        [ -n "$proxy_domains" ] || proxy_domains=$(extract_domains proxy-domains "美国静态住宅IP")
    fi
    if has_param proxy_keywords; then
        proxy_keywords=$(normalize_keywords "$(param proxy_keywords)")
    else
        proxy_keywords=$(extract_keywords proxy-keywords "$RES_GROUP")
        [ -n "$proxy_keywords" ] || proxy_keywords=$(extract_keywords proxy-keywords "美国静态住宅IP")
    fi
    if has_param jp_domains; then
        jp_domains=$(normalize_domains "$(param jp_domains)")
    else
        jp_domains=$(extract_domains jp-domains "$JP_RULE_GROUP")
    fi
    if [ "$scope" = "rules" ]; then
        write_rules_file "$direct_domains" "$proxy_domains" "$direct_keywords" "$proxy_keywords" "$jp_domains"
        [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >/dev/null 2>&1
        ok "分流网站已保存。点击顶部“更新配置”后生效。"
    fi

    [ -n "$subscription" ] && {
        set_cfg_quoted Https "$subscription"
        set_cfg_quoted Url "$subscription"
    }
    ensure_shellcrash_flags
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >/dev/null 2>&1
    write_rules_file "$direct_domains" "$proxy_domains" "$direct_keywords" "$proxy_keywords" "$jp_domains"
    ok "已保存。点击顶部“更新配置”后生效。"
}
get_subscription() {
    local sub sub_j
    require_shellcrash
    sub=$(get_cfg_value Https)
    [ -n "$sub" ] || sub=$(get_cfg_value Url)
    sub_j=$(json_escape "$sub")
    send_json "{\"ok\":true,\"subscription\":\"$sub_j\"}"
}
update_subscription() {
    local subscription
    require_shellcrash
    subscription=$(one_line "$(param subscription_url)")
    if [ -n "$subscription" ]; then
        backup_file "$CFG_FILE"
        set_cfg_quoted Https "$subscription"
        set_cfg_quoted Url "$subscription"
    fi
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >/dev/null 2>&1
    "$BASE/task/task.sh" update_config >"$APP_DIR/last-update.log" 2>&1
    [ -x "$SETUP_SCRIPT" ] && SHELLCRASH_HOME="$BASE" "$SETUP_SCRIPT" >/dev/null 2>&1
    [ -x "$LEAK_GUARD" ] && "$LEAK_GUARD" >/dev/null 2>&1
    publish_client_subscription || fail "订阅更新完成，但同步到公网客户端订阅失败。请到高级日志或 last-client-subscription.log 查看原因。"
    ok "订阅更新完成，静态住宅出口配置仍然保留，公网客户端订阅也已同步。"
}
control_shellcrash() {
    local op="$1"
    require_shellcrash
    ( "$BASE/start.sh" "$op" >"$APP_DIR/last-service.log" 2>&1 ) &
    ok "ShellCrash 已执行 $op，请稍等后刷新状态。"
}
install_shellcrash() {
    local release install_dir install_url alias
    [ -x "$INSTALL_SCRIPT" ] || fail "安装脚本不存在，请重新安装管理器。"
    release=$(one_line "$(param release)")
    install_dir=$(one_line "$(param install_dir)")
    install_url=$(one_line "$(param install_url)")
    alias=$(one_line "$(param alias)")
    [ -n "$release" ] || release=master
    [ -n "$install_url" ] || install_url="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@master"
    [ -n "$alias" ] || alias=crash
    (
        SC_RELEASE="$release" \
        SC_DIR="$install_dir" \
        SC_URL="$install_url" \
        SC_ALIAS="$alias" \
        MANAGER_DIR="$APP_DIR" \
        "$INSTALL_SCRIPT"
    ) >"$APP_DIR/last-install.log" 2>&1 &
    ok "已开始安装或覆盖安装 ShellCrash，日志会实时写入安装日志。"
}
save_panel() {
    local panel_port panel_path ui_url panel_url panel_url_j host
    require_shellcrash
    panel_port=$(one_line "$(param panel_port)")
    panel_path=$(one_line "$(param panel_path)")
    ui_url=$(one_line "$(param external_ui_url)")
    [ -n "$panel_port" ] || panel_port=9999
    [ -n "$panel_path" ] || panel_path=/ui
    case "$panel_port" in
        ''|*[!0-9]*) fail "面板端口只能填写数字，比如 9999。" ;;
    esac
    echo "$panel_path" | grep -Eq '^/[A-Za-z0-9_./-]*$' || fail "面板路径需要以 / 开头，比如 /ui。"
    backup_file "$CFG_FILE"
    set_cfg_plain db_port "$panel_port"
    set_cfg_quoted hostdir ":$panel_port$panel_path"
    [ -n "$ui_url" ] && set_cfg_plain external_ui_url "$ui_url"
    host=$(router_host)
    panel_url="http://${host}:${panel_port}${panel_path}/"
    panel_url_j=$(json_escape "$panel_url")
    send_json "{\"ok\":true,\"message\":\"面板地址已保存。点击顶部“更新配置”后生效。\",\"panelUrl\":\"$panel_url_j\"}"
}
test_exit() {
    local trace ip loc http ip_j loc_j http_j
    trace=$(curl -k -s --max-time 18 --proxy http://127.0.0.1:7890 https://chatgpt.com/cdn-cgi/trace 2>/dev/null)
    ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p' | head -n 1)
    loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p' | head -n 1)
    http=$(printf '%s\n' "$trace" | sed -n 's/^http=//p' | head -n 1)
    [ -n "$ip" ] || fail "测试失败：暂时没有拿到 ChatGPT trace 结果。"
    ip_j=$(json_escape "$ip")
    loc_j=$(json_escape "$loc")
    http_j=$(json_escape "$http")
    send_json "{\"ok\":true,\"message\":\"测试完成\",\"ip\":\"$ip_j\",\"loc\":\"$loc_j\",\"http\":\"$http_j\"}"
}
read_log() {
    local name file content
    name=$(one_line "$(param name)")
    case "$name" in
        install) file="$APP_DIR/last-install.log" ;;
        update) file="$APP_DIR/last-update.log" ;;
        service) file="$APP_DIR/last-service.log" ;;
        guard) file="$APP_DIR/last-guard.log" ;;
        *) file="$APP_DIR/uhttpd.log" ;;
    esac
    content=$(tail -n 80 "$file" 2>/dev/null)
    content=$(json_escape "$content")
    send_json "{\"ok\":true,\"content\":\"$content\"}"
}
action=$(one_line "$(param action)")
[ -n "$action" ] || action=status
case "$action" in
    status) status_json ;;
    get_subscription) get_subscription ;;
    install_shellcrash) install_shellcrash ;;
    save) save_config ;;
    save_panel) save_panel ;;
    update_subscription) update_subscription ;;
    start) control_shellcrash start ;;
    stop) control_shellcrash stop ;;
    restart) control_shellcrash restart ;;
    test_exit) test_exit ;;
    log) read_log ;;
    *) fail "未知操作。" ;;
esac
